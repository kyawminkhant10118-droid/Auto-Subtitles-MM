# GEMINI_API_KEY: Required for Gemini AI API calls (Burmese Translation & Fallback Transcription).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional/Configurable for Groq Whisper (whisper-large-v3) speech recognition & timestamp extraction.
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# UPLOAD & PROCESSING CONFIGURATION
MAX_UPLOAD_SIZE_MB="250"
CHUNK_DURATION_SECONDS="180"
TEMP_STORAGE_DIR="./tmp"
WHISPER_MODEL_SIZE="whisper-large-v3"
